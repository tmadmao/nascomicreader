<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限按功能最小化。当前只声明远程书库需要的两条：
        INTERNET               WebDAV 列目录、取页
        ACCESS_LOCAL_NETWORK   局域网 NAS（targetSdk 37 起需要，公网地址不影响）
      后续真要后台扫描再加 FOREGROUND_SERVICE 与 POST_NOTIFICATIONS。
      存储一律走 SAF 持久化授权，不申请任何外部存储权限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 局域网 NAS 常见只有 http，允许明文；账号密码走 Basic，不额外加密 -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NasComic">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.detail.DetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.about.LicensesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.sources.SourcesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.remote.RemotePickerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.reader.ReadingActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

    </application>

</manifest>
