<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/shell_surface"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- 切到书签时给排序钮留出同样的空间，避免两个页签改变位置。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/toc_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            app:tabIndicatorColor="@color/brand_accent"
            app:tabIndicatorFullWidth="false"
            app:tabSelectedTextColor="@color/brand_accent_deep"
            app:tabTextColor="@color/shell_ink" />

        <TextView
            android:id="@+id/toc_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/detail_order_asc"
            android:textColor="@color/brand_accent_deep"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/toc_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/toc_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </ScrollView>
</LinearLayout>
