<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <com.nascomic.reader.ui.widget.AspectImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cover_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- 已读进度：贴着封面底边的一条横线，没读过的不画 -->
    <com.nascomic.reader.ui.widget.CoverProgress
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="3dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/shell_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/shell_ink_muted"
        android:textSize="11sp" />

</LinearLayout>
