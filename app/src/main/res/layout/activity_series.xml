<?xml version="1.0" encoding="utf-8"?>
<!--
  作品系列详情。骨架与书籍详情页一致（封面 + 信息 + 一个主动作 + 目录），
  区别只在目录列的是「卷」而不是「章」——系列就是连载的一本书。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/action_back"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/shell_ink" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/series_menu"
            android:padding="8dp"
            android:src="@drawable/ic_more_line" />
    </LinearLayout>

    <!-- 系列信息：封面取首卷 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/page_margin">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="92dp"
            android:layout_height="124dp"
            android:background="@color/cover_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/shell_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/shell_ink_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/read_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/shell_ink_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 一个主动作 -->
    <TextView
        android:id="@+id/primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/page_margin"
        android:background="@drawable/bg_primary"
        android:gravity="center"
        android:textColor="@color/shell_surface"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/series_volumes"
            android:textColor="@color/shell_ink_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/volume_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/shell_ink_faint"
            android:textSize="10.5sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/volume_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/series_empty"
        android:textColor="@color/shell_ink_faint"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
