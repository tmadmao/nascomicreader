<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.nascomic.reader.ui.reader.ReaderView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 常驻页码：不打扰画面，翻页时能看到位置 -->
    <TextView
        android:id="@+id/page_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="#66000000"
        android:maxWidth="300dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- 顶部栏：点屏幕中间显隐 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D016181C"
        android:orientation="horizontal"
        android:minHeight="52dp"
        android:paddingVertical="2dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back" />

        <TextView
            android:id="@+id/book_title"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:singleLine="true"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- 底栏五键：上一页 · 设置 · 书签 · 目录 · 下一页 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        android:layout_gravity="bottom"
        android:background="#D016181C"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/prev_page"
            style="@style/ReaderBarItem">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron"
                android:contentDescription="@null" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/reader_prev_page" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_settings"
            style="@style/ReaderBarItem">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings_line"
                android:contentDescription="@null" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/action_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bookmark"
            style="@style/ReaderBarItem">

            <ImageView
                android:id="@+id/bookmark_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="@string/reader_bookmark" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/reader_bookmark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toc"
            style="@style/ReaderBarItem">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_toc"
                android:contentDescription="@null" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/reader_toolbar_toc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next_page"
            style="@style/ReaderBarItem">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron"
                android:contentDescription="@null" />

            <TextView
                style="@style/ReaderBarLabel"
                android:text="@string/reader_next_page" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="32dp"
        android:gravity="center"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
