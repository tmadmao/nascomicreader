<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      设计基线（见 ui/ 里的界面稿）：暖纸面 + 墨字 + 一支橙。
      层次靠「纸面 → 白卡」两级明度叠出来，再用 1dp 暖灰描边分开；
      强调色只有一支橙，深靛只用在「接着读」这类深色卡片上。
    -->
    <color name="shell_background">#F8F5EF</color>
    <color name="shell_surface">#FFFFFF</color>
    <!-- 压在纸面上的次白：搜索框、底部操作条的底 -->
    <color name="shell_surface_soft">#FCFAF6</color>
    <color name="shell_ink">#1B1C20</color>
    <color name="shell_ink_muted">#6F6A62</color>
    <!-- 只给计数、单位这类不必读的附注用 -->
    <color name="shell_ink_faint">#9A958B</color>
    <color name="shell_divider">#F0EBE2</color>
    <color name="shell_stroke">#ECE7DE</color>

    <color name="brand_accent">#F06A35</color>
    <color name="brand_accent_press">#D8571F</color>
    <!-- 橙色卡片底：进度卡、提示条 -->
    <color name="brand_accent_tint">#FFF0E5</color>
    <!-- 橙底上的字：比橙深一档才看得清 -->
    <color name="brand_accent_deep">#C45C34</color>
    <!-- 深色画布 / 深色卡片上的强调色 -->
    <color name="brand_accent_soft">#FF9464</color>

    <!-- 深色卡片的底与叠在上面的两档明度 -->
    <color name="night_surface">#1A2338</color>
    <color name="night_surface_deep">#10182D</color>
    <color name="night_surface_soft">#2E4062</color>

    <!-- 书源管理：三种来源各给一块底色，与主色系不冲突 -->
    <color name="tile_local_bg">#F9E8DC</color>
    <color name="tile_local_ink">#DF6938</color>
    <color name="tile_webdav_bg">#EFE9F5</color>
    <color name="tile_webdav_ink">#7F639A</color>
    <color name="tile_smb_bg">#E7F0E8</color>
    <color name="tile_smb_ink">#5D8766</color>
    <color name="tile_neutral_bg">#F2EEE6</color>
    <color name="tile_neutral_ink">#8E877C</color>

    <!-- 书源管理的横幅与选中态 -->
    <color name="banner_green">#E9EFE4</color>
    <color name="banner_ink">#253728</color>
    <color name="banner_muted">#657867</color>
    <color name="selected_card_bg">#FFF4EC</color>

    <color name="cover_placeholder">#EFEAE1</color>
    <color name="tab_active">#1B1C20</color>
    <color name="tab_inactive">#6F6A62</color>
</resources>
