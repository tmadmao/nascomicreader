<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则：远程仓库凭据不参与云备份与设备迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="reader_secure.db" />
        <exclude domain="sharedpref" path="reader_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="reader_secure.db" />
        <exclude domain="sharedpref" path="reader_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
